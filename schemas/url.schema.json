{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "URLRecord",
  "description": "Normalized record representing an enumerated or crawled web endpoint.",
  "type": "object",
  "required": ["url", "host", "target"],
  "properties": {
    "url": {
      "type": "string",
      "format": "uri",
      "description": "Full URL of the discovered web resource."
    },
    "host": {
      "type": "string",
      "format": "hostname",
      "description": "Extracted hostname of the URL."
    },
    "target": {
      "type": "string",
      "format": "hostname",
      "description": "Root assessment target domain."
    },
    "status_code": {
      "type": "integer",
      "description": "HTTP response status code if probed."
    },
    "title": {
      "type": "string",
      "description": "HTML page title if retrieved."
    },
    "source": {
      "type": "string",
      "description": "Discovery source tool (e.g. katana, httpx)."
    }
  },
  "additionalProperties": true
}
