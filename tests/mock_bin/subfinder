#!/usr/bin/env bash
if [[ "${MOCK_FAIL_SUBFINDER:-0}" == "1" ]]; then
    echo "Mock subfinder failure" >&2
    exit 1
fi
out=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -o) out="$2"; shift 2 ;;
        *) shift ;;
    esac
done
MOCK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FIXTURE="$MOCK_DIR/../fixtures/subfinder_sample.txt"
if [[ -n "$out" && -f "$FIXTURE" ]]; then
    grep -v '^#' "$FIXTURE" > "$out"
fi
exit 0
