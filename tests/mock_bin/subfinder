#!/usr/bin/env bash
if [[ "${MOCK_FAIL_SUBFINDER:-0}" == "1" ]]; then
    echo "Mock subfinder failure" >&2
    exit 1
fi
out=""
dom=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -o) out="$2"; shift 2 ;;
        -d) dom="$2"; shift 2 ;;
        *) shift ;;
    esac
done
# Use MOCK_TEST_MODE env var set by test runner
MOCK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FIXTURE="$MOCK_DIR/../fixtures/subfinder_sample.txt"
if [[ "${MOCK_TEST_MODE:-0}" == "1" && -f "$FIXTURE" ]]; then
    grep -v '^#' "$FIXTURE" > "$out"
else
    : > "$out"
fi
if [[ -n "$dom" ]]; then
    echo "sub.${dom}" >> "$out"
    echo "api.${dom}" >> "$out"
fi
exit 0
