#!/usr/bin/env bash
if [[ "${MOCK_FAIL_KATANA:-0}" == "1" ]]; then
    echo "Mock katana failure" >&2
    exit 1
fi
inp=""
out=""
dom=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -list) inp="$2"; shift 2 ;;
        -o) out="$2"; shift 2 ;;
        -d) dom="$2"; shift 2 ;;
        *) shift ;;
    esac
done
# Use MOCK_TEST_MODE env var set by test runner
if [[ "${MOCK_TEST_MODE:-0}" == "1" && -n "$inp" && -f "$inp" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ -n "$line" ]]; then
            echo "${line}/api/v1" >> "$out"
            echo "${line}/login" >> "$out"
        fi
    done < "$inp"
else
    : > "$out"
fi
exit 0
