#!/usr/bin/env bash
if [[ "${MOCK_FAIL_ASSETFINDER:-0}" == "1" ]]; then
    echo "Mock assetfinder failure" >&2
    exit 1
fi
dom=""
out=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -d) dom="$2"; shift 2 ;;
        -o) out="$2"; shift 2 ;;
        *) shift ;;
    esac
done
# Use MOCK_TEST_MODE env var set by test runner
MOCK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FIXTURE="$MOCK_DIR/../fixtures/assetfinder_sample.txt"
if [[ "${MOCK_TEST_MODE:-0}" == "1" && -f "$FIXTURE" ]]; then
    grep -v '^#' "$FIXTURE" > "$out"
else
    : > "$out"
fi
if [[ -n "$dom" ]]; then
    echo "sub.${dom}" >> "$out"
    echo "api.${dom}" >> "$out"
fi
exit 0