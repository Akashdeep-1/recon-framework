#!/usr/bin/env bash
if [[ "${MOCK_FAIL_HTTPX:-0}" == "1" ]]; then
    echo "Mock httpx failure" >&2
    exit 1
fi
inp=""
out=""
dom=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -l) inp="$2"; shift 2 ;;
        -o) out="$2"; shift 2 ;;
        -d) dom="$2"; shift 2 ;;
        *) shift ;;
    esac
done
# Only use fixture data in test mode
USE_FIXTURE=0
if [[ "$dom" == "mocktarget.com" || "$dom" == *"mocktarget.com" || "$dom" == "testmanifest.com" || "$dom" == "target.com" || "$dom" == "authorized-target.com" || "$dom" == "stages-test.com" || "$dom" == "skip-test.com" || "$dom" == "failure-test.com" || "$dom" == "retry-test.com" || "$dom" == "resumetarget.com" || "$dom" == "crash-recovery-test.com" || "$dom" == "naabu-ports-test.com" || "$dom" == "reportcheck.com" ]]; then
    USE_FIXTURE=1
fi
if [[ -n "$out" ]]; then
    if [[ -n "$inp" && -f "$inp" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            if [[ -n "$line" ]]; then
                if [[ "$line" == http* ]]; then
                    echo "$line [200] [Mock OK] [nginx]" >> "$out"
                else
                    echo "https://$line [200] [Mock OK] [nginx]" >> "$out"
                fi
            fi
        done < "$inp"
    else
        : > "$out"
    fi
fi
exit 0
