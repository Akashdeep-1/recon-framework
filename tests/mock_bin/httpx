#!/usr/bin/env bash
if [[ "${MOCK_FAIL_HTTPX:-0}" == "1" ]]; then
    echo "Mock httpx failure" >&2
    exit 1
fi
inp=""
out=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -l) inp="$2"; shift 2 ;;
        -o) out="$2"; shift 2 ;;
        *) shift ;;
    esac
done
if [[ -n "$out" ]]; then
    if [[ -n "$inp" && -f "$inp" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            if [[ -n "$line" ]]; then
                if [[ "$line" == http* ]]; then
                    echo "$line [200] [Mock OK] [nginx]" >> "$out"
                else
                    echo "https://$line [200] [Mock OK] [nginx]" >> "$out"
                fi
            fi
        done < "$inp"
    else
        : > "$out"
    fi
fi
exit 0
