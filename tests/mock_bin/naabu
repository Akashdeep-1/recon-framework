#!/usr/bin/env bash
if [[ "${MOCK_FAIL_NAABU:-0}" == "1" ]]; then
    echo "Mock naabu failure" >&2
    exit 1
fi
inp=""
out=""
ports_val=""
dom=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -list) inp="$2"; shift 2 ;;
        -o) out="$2"; shift 2 ;;
        -top-ports) ports_val="$2"; shift 2 ;;
        -d) dom="$2"; shift 2 ;;
        *) shift ;;
    esac
done
# Capture the -top-ports argument for test verification when requested
if [[ -n "${MOCK_NAABU_PORTS_FILE:-}" && -n "$ports_val" ]]; then
    printf '%s' "$ports_val" > "$MOCK_NAABU_PORTS_FILE"
fi
# Use MOCK_TEST_MODE env var set by test runner
MOCK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FIXTURE="$MOCK_DIR/../fixtures/naabu_sample.txt"
if [[ "${MOCK_TEST_MODE:-0}" == "1" && -f "$FIXTURE" ]]; then
    if [[ -n "$inp" && ! -f "$inp" ]]; then
        echo "Mock naabu: input file not found: $inp" >&2
        exit 1
    fi
    cat "$FIXTURE" > "$out"
else
    : > "$out"
fi
exit 0
