#!/usr/bin/env bash
if [[ "${MOCK_FAIL_NUCLEI:-0}" == "1" ]]; then
    echo "Mock nuclei failure" >&2
    exit 1
fi
out=""
dom=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -o) out="$2"; shift 2 ;;
        -d) dom="$2"; shift 2 ;;
        *) shift ;;
    esac
done
# Only use fixture data in test mode
USE_FIXTURE=0
if [[ "$dom" == "mocktarget.com" || "$dom" == *"mocktarget.com" || "$dom" == "testmanifest.com" || "$dom" == "target.com" || "$dom" == "authorized-target.com" || "$dom" == "stages-test.com" || "$dom" == "skip-test.com" || "$dom" == "failure-test.com" || "$dom" == "retry-test.com" || "$dom" == "resumetarget.com" || "$dom" == "crash-recovery-test.com" || "$dom" == "naabu-ports-test.com" || "$dom" == "reportcheck.com" ]]; then
    USE_FIXTURE=1
fi
MOCK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FIXTURE="$MOCK_DIR/../fixtures/nuclei_sample.jsonl"
if [[ -n "$out" && -f "$FIXTURE" ]]; then
    if [[ "$USE_FIXTURE" -eq 1 ]]; then
        cat "$FIXTURE" > "$out"
    else
        : > "$out"
    fi
fi
exit 0
