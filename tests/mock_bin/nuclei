#!/usr/bin/env bash
if [[ "${MOCK_FAIL_NUCLEI:-0}" == "1" ]]; then
    echo "Mock nuclei failure" >&2
    exit 1
fi
out=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -o) out="$2"; shift 2 ;;
        *) shift ;;
    esac
done
MOCK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FIXTURE="$MOCK_DIR/../fixtures/nuclei_sample.jsonl"
if [[ -n "$out" && -f "$FIXTURE" ]]; then
    cat "$FIXTURE" > "$out"
fi
exit 0
