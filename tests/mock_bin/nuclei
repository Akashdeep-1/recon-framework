#!/usr/bin/env bash
if [[ "${MOCK_FAIL_NUCLEI:-0}" == "1" ]]; then
    echo "Mock nuclei failure" >&2
    exit 1
fi
out=""
dom=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -o) out="$2"; shift 2 ;;
        -d) dom="$2"; shift 2 ;;
        *) shift ;;
    esac
done
# Use MOCK_TEST_MODE env var set by test runner
MOCK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FIXTURE="$MOCK_DIR/../fixtures/nuclei_sample.jsonl"
if [[ "${MOCK_TEST_MODE:-0}" == "1" && -f "$FIXTURE" ]]; then
    cat "$FIXTURE" > "$out"
else
    : > "$out"
fi
exit 0
