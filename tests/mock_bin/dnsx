#!/usr/bin/env bash
if [[ "${MOCK_FAIL_DNSX:-0}" == "1" ]]; then
    echo "Mock dnsx failure" >&2
    exit 1
fi

if [[ -n "${MOCK_FAIL_DNSX_FILE:-}" ]]; then
    cnt=0
    if [[ -f "$MOCK_FAIL_DNSX_FILE" ]]; then
        cnt=$(wc -l < "$MOCK_FAIL_DNSX_FILE" | tr -d ' ')
    fi
    echo "attempt" >> "$MOCK_FAIL_DNSX_FILE"
    max_fails="${MOCK_FAIL_DNSX_COUNT:-1}"
    if (( cnt < max_fails )); then
        echo "Mock dnsx transient failure ($(( cnt + 1 ))/$max_fails)" >&2
        exit 1
    fi
fi

if [[ -n "${MOCK_SLEEP_DNSX:-}" ]]; then
    sleep "$MOCK_SLEEP_DNSX"
fi
inp=""
out=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -l) inp="$2"; shift 2 ;;
        -o) out="$2"; shift 2 ;;
        *) shift ;;
    esac
done
if [[ -n "$out" ]]; then
    if [[ -n "$inp" && -f "$inp" ]]; then
        # Echo resolved entries for input
        awk '{print $1 " [10.0.0.1]"}' "$inp" > "$out"
    else
        : > "$out"
    fi
fi
exit 0
